<!DOCTYPE html>
<html>
<head>
    <title>Groundwork — Submit a ticket</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: sans-serif; color: #3A2E28; }
        .split-wrap { display: flex; min-height: 100vh; }
        .split-left { flex: 1 1 50%; position: relative; overflow: hidden; display: flex; align-items: flex-end; }
        .split-bg { position: absolute; inset: 0; background-image: url('/images/utah.jpg'); background-size: cover; background-position: center; }
        .split-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(30,24,20,0.7), rgba(30,24,20,0.15)); }
        .split-quote { position: relative; z-index: 1; color: #FAF3E8; padding: 48px; font-size: 16px; line-height: 1.6; max-width: 400px; }
        .split-right { flex: 1 1 50%; background: #FAF3E8; display: flex; align-items: center; justify-content: center; padding: 60px; overflow-y: auto; }
        .form-inner { max-width: 400px; width: 100%; }
        .site-logo { display: inline-block; font-size: 17px; font-weight: bold; color:#D98E58; text-decoration: none; margin-bottom: 20px; }
        a.back { display: block; margin-bottom: 16px; color: #8A7A68; text-decoration:none; font-size: 13px; }
        h2 { font-size: 26px; margin: 0 0 8px 0; }
        .note { font-size: 12px; color: #8A7A68; margin-bottom: 20px; }
        label { font-size: 12px; color: #8A7A68; display: block; margin-bottom: 6px; font-weight: 600; }
        input, textarea, select { width: 100%; box-sizing: border-box; border: 1px solid #E4D8C4; border-radius: 8px; padding: 10px 12px; font-size: 14px; margin-bottom: 14px; background: #FFFDF9; font-family: inherit; }
        button { width: 100%; background: #D98E58; color: #FAF3E8; border: none; border-radius: 10px; padding: 12px; font-size: 14px; font-weight: bold; }
        @media (max-width: 900px) { .split-left { display: none; } }
    </style>
</head>
<body>
    <div class="split-wrap">
        <div class="split-left">
            <div class="split-bg"></div>
            <div class="split-overlay"></div>
            <div class="split-quote">"No account needed — tell us what's broken and we'll take it from here."</div>
        </div>
        <div class="split-right">
            <div class="form-inner">
                <a href="/" class="site-logo">Groundwork</a>
                <a class="back" href="/new">&larr; Back</a>
                <h2>New ticket — Guest</h2>
                <p class="note">Submitting as a guest. Priority defaults to Low but can be adjusted based on urgency.</p>
                <form method="POST" action="/new/guest">
                    <label>Your name</label>
                    <input type="text" name="name" required>
                    <label>Subject</label>
                    <input type="text" name="subject" required>
                    <label>Description</label>
                    <textarea name="description" rows="3" required></textarea>
                    <label>Priority</label>
                    <select name="priority">
                        <option selected>Low</option>
                        <option>Medium</option>
                        <option>High</option>
                    </select>
                    <label>Category</label>
                    <select name="category">
                        <option>Hardware</option>
                        <option selected>Software</option>
                        <option>Network</option>
                        <option>Account access</option>
                    </select>
                    <button type="submit">Submit ticket</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
