<!DOCTYPE html>
<html>
<head>
    <title>Groundwork — Submit a ticket</title>
    <style>
        body { background: #FAF3E8; font-family: sans-serif; color: #3A2E28; max-width: 420px; margin: 40px auto; }
        a.back { display: inline-block; margin-bottom: 16px; color: #8A7A68; text-decoration: none; font-size: 13px; }
        input, textarea, select { width: 100%; box-sizing: border-box; border: 1px solid #E4D8C4; border-radius: 8px; padding: 9px 12px; font-size: 14px; margin-bottom: 14px; background: #FFFDF9; }
        label { font-size: 12px; color: #8A7A68; display: block; margin-bottom: 6px; }
        button { width: 100%; background: #D98E58; color: #FAF3E8; border: none; border-radius: 10px; padding: 10px; font-size: 14px; font-weight: bold; }
        .note { font-size: 12px; color: #8A7A68; margin-bottom: 20px; }
    </style>
</head>
<body>
    <a class="back" href="/new">&larr; Back</a>
    <h2>New ticket — Guest</h2>
    <p class="note">Submitting as a guest. Priority defaults to Low but can be adjusted based on urgency.</p>
    <form method="POST" action="/new/guest">
        <label>Your name</label>
        <input type="text" name="name" required>

        <label>Subject</label>
        <input type="text" name="subject" required>

        <label>Description</label>
        <textarea name="description" rows="3" required></textarea>

        <label>Priority</label>
        <select name="priority">
            <option selected>Low</option>
            <option>Medium</option>
            <option>High</option>
        </select>

        <label>Category</label>
        <select name="category">
            <option>Hardware</option>
            <option selected>Software</option>
            <option>Network</option>
            <option>Account access</option>
        </select>

        <button type="submit">Submit ticket</button>
    </form>
</body>
</html>
