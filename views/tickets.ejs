<!DOCTYPE html>
<html>
<head>
    <title>Groundwork — Tickets</title>
    <style>
        body { background: #FAF3E8; font-family: sans-serif; color: #3A2E28; max-width: 760px; margin: 40px auto; }
        a.button { display: inline-block; background: #D98E58; color: #FAF3E8; text-decoration: none; padding: 8px 14px; border-radius: 10px; font-size: 14px; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; background: #FFFDF9; border-radius: 12px; overflow: hidden; }
        th, td { text-align: left; padding: 10px 14px; font-size: 14px; border-bottom: 1px solid #F0E4D3; }
        th { font-size: 11px; color: #8A7A68; text-transform: uppercase; }
        table a { color: #9CAF88; text-decoration: none; }
        table a:visited { color: #6B7B4F; }
        table a:hover { text-decoration: underline; }
        a.back { display: inline-block; margin-bottom: 16px; color: #8A7A68; text-decoration: none; font-size: 13px; }
        .guest-tag { font-size: 10px; color: #8A7A68; background: #F0E4D3; padding: 2px 6px; border-radius: 6px; margin-left: 4px; }
    </style>
</head>
<body>
    <a class="back" href="/">&larr; Back to home</a>
    <h2>Groundwork</h2>
    <a class="button" href="/new">+ New ticket</a>
    <table>
        <tr><th>Subject</th><th>Submitted By</th><th>Priority</th><th>Category</th><th>Status</th></tr>
        <% tickets.forEach(function(ticket) { %>
        <tr>
            <td><a href="/ticket/<%= ticket.id %>">#<%= ticket.id %> <%= ticket.subject %></a></td>
            <td><%= ticket.submittedBy %><% if (!ticket.customerId) { %> <span class="guest-tag">Guest</span><% } %></td>
            <td><%= ticket.priority %></td>
            <td><%= ticket.category %></td>
            <td style="color: <%= ticket.status === 'Resolved' ? '#6B7B4F' : '#3A2E28' %>; font-weight: <%= ticket.status === 'Resolved' ? 'bold' : 'normal' %>;"><%= ticket.status %></td>
        </tr>
        <% }); %>
    </table>
</body>
</html>
