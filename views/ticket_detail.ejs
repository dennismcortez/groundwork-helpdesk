<!DOCTYPE html>
<html>
<head>
    <title>Groundwork — Ticket #<%= ticket.id %></title>
    <style>
        body { background: #FAF3E8; font-family: sans-serif; color: #3A2E28; margin: 0; }
        .page-wrap { max-width: 460px; margin: 0 auto; padding: 40px 20px; }
        .site-logo { display: inline-block; font-size: 17px; font-weight: bold; color:#D98E58; text-decoration: none; margin-bottom: 20px; }
        a.back { display: block; margin-bottom: 16px; color: #8A7A68; text-decoration:none; font-size: 13px; }
        h2 { font-size: 24px; margin: 0 0 16px 0; }
        .card { background: #FFFDF9; border: 1px solid #E4D8C4; border-radius: 16px; padding: 24px 28px; box-shadow: 0 4px 24px rgba(58,46,40,0.06); }
        .field { margin-bottom: 14px; }
        .label { font-size: 11px; color: #8A7A68; display: block; margin-bottom: 4px; }
        select { width: 100%; box-sizing: border-box; border: 1px solid #E4D8C4; border-radius: 8px; padding: 10px 12px; font-size: 14px; background: #FFFDF9; margin-bottom:14px; }
        button { width: 100%; background: #D98E58; color: #FAF3E8; border: none; border-radius: 10px; padding: 12px; font-size: 14px; font-weight: bold; }
        .guest-tag { font-size: 10px; color: #8A7A68; background: #F0E4D3; padding: 2px 6px; border-radius: 6px; margin-left: 4px; }
        .email-line { font-size: 13px; color: #8A7A68; }
        .unassigned { color: #A89A8A; font-style: italic; }
    </style>
</head>
<body>
    <div class="page-wrap">
        <a href="/" class="site-logo">Groundwork</a>
        <a class="back" href="/staff">&larr; Back to tickets</a>
        <h2>#<%= ticket.id %> <%= ticket.subject %></h2>

        <div class="card">
            <div class="field">
                <span class="label">Submitted By</span>
                <%= ticket.submittedBy %>
                <% if (!ticket.customerId) { %> <span class="guest-tag">Guest</span><%} %>
                <% if (customerEmail) { %><br><span class="email-line"><%= customerEmail %></span><% } %>
            </div>
            <div class="field">
                <span class="label">Assigned To</span>
                <% if (assignee) { %><%= assignee %><% } else { %><span class="unassigned">Unassigned</span><% } %>
            </div>
            <div class="field">
                <span class="label">Priority</span>
                <%= ticket.priority %>
            </div>
            <div class="field">
                <span class="label">Category</span>
                <%= ticket.category %>
            </div>
            <div class="field">
                <span class="label">Description</span>
                <%= ticket.description %>
            </div>
            <div class="field">
                <span class="label">Opened</span>
                <%= ticket.openedAt.toLocaleString() %>
            </div>
            <% if (ticket.resolvedAt) { %>
            <div class="field">
                <span class="label">Resolved</span>
                <%= ticket.resolvedAt.toLocaleString() %>
            </div>
            <% } %>

            <form method="POST" action="/ticket/<%= ticket.id %>">
                <label class="label">Status</label>
                <select name="status">
                    <option <%= ticket.status === "Open" ? "selected" : "" %>>Open</option>
                    <option <%= ticket.status === "In Progress" ? "selected" : "" %>>In Progress</option>
                    <option <%= ticket.status === "Resolved" ? "selected" : "" %>>Resolved</option>
                </select>
                <button type="submit">Save changes</button>
            </form>
        </div>
    </div>
</body>
</html>
