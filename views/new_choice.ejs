<!DOCTYPE html>
<html>
<head>
    <title>Groundwork — Submit a ticket</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: sans-serif; color: #3A2E28; min-height: 100vh; position: relative; overflow: hidden; }
        .bg { position: fixed; inset: 0; background-image: url('/images/utah.jpg'); background-size: cover; background-position: center; z-index: -2; }
        .overlay { position: fixed; inset: 0; background: linear-gradient(to bottom, rgba(250,243,232,0.85) 0%, rgba(250,243,232,0.65) 40%, rgba(250,243,232,0.5) 100%); z-index: -1; }
        .site-logo { position: absolute; top: 24px; left: 40px; font-size: 17px; font-weight: bold; color: #D98E58; text-decoration: none; z-index: 10; }
        a.back { position: absolute; top: 26px; right: 40px; color: #3A2E28; text-decoration: none; font-size: 13px; background: rgba(255,253,249,0.7); padding: 6px 12px; border-radius: 8px; z-index: 10; }
        .center { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; position: relative; z-index: 1; }
        h2 { margin: 0 0 28px 0; font-size: 30px; }
        .panel { background: rgba(255,253,249,0.92); border: 1px solid #E4D8C4; border-radius: 20px; padding: 36px 40px; width: 360px; text-align: center; box-shadow: 0 12px 40px rgba(58,46,40,0.15); backdrop-filter: blur(4px); }
        .signin-btn { display: block; background: #D98E58; color: #FAF3E8; text-decoration: none; padding: 13px; border-radius: 10px; font-weight: bold; font-size: 15px; margin-bottom: 12px; }
        .signup-link { display: block; font-size: 13px; color: #8A7A68; text-decoration: none; margin-bottom: 24px; }
        .divider { display: flex; align-items: center; color: #C4B5A0; font-size: 12px; margin: 20px 0; }
        .divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: #E4D8C4; }
        .divider span { padding: 0 12px; }
        .guest-link { display: block; color: #6B5B4F; text-decoration: underline; font-size: 14px; }
    </style>
</head>
<body>
    <div class="bg"></div>
    <div class="overlay"></div>
    <a href="/" class="site-logo">Groundwork</a>
    <a class="back" href="/">&larr; Back to home</a>
    <div class="center">
        <h2>Submit a Ticket</h2>
        <div class="panel">
            <a class="signin-btn" href="/account/login">Sign In</a>
            <a class="signup-link" href="/account/signup">Don't have an account? Sign up</a>
            <div class="divider"><span>or</span></div>
            <a class="guest-link" href="/new/guest">Continue as Guest</a>
        </div>
    </div>
</body>
</html>
